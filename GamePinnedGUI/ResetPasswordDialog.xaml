<Window x:Class="GamePinned.GUI.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Reset Admin Password"
        SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <materialDesign:PackIcon Kind="ShieldRefresh" Foreground="#e60012"
                                     Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,10,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Reset Admin Password"
                           FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                <TextBlock Text="Your Windows account credentials will be used to verify your identity."
                           FontSize="12" Foreground="#888" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Current Windows account (read-only info) -->
        <Border Grid.Row="1" Background="#252525" CornerRadius="4" Padding="12,8" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AccountCircle" Foreground="#666"
                                         Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Verifying as: " FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                <TextBlock x:Name="UsernameText" FontSize="12" Foreground="#CCC"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- New password fields -->
        <StackPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock Text="NEW GAMEPINNED ADMIN PASSWORD"
                       FontSize="10" FontWeight="SemiBold" Foreground="#555"
                       Margin="0,0,0,10"/>
            <PasswordBox x:Name="NewPasswordBox"
                         FontSize="14" Padding="8" Foreground="White"
                         materialDesign:HintAssist.Hint="New password (min. 4 characters)"
                         Margin="0,0,0,8"
                         KeyDown="PasswordBox_KeyDown"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         FontSize="14" Padding="8" Foreground="White"
                         materialDesign:HintAssist.Hint="Confirm new password"
                         KeyDown="PasswordBox_KeyDown"/>
        </StackPanel>

        <!-- Error text -->
        <TextBlock x:Name="ErrorText"
                   Grid.Row="3"
                   FontSize="12" Foreground="#e60012"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="CANCEL"
                    Click="Cancel_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#333333"
                    Margin="0,0,10,0"
                    Width="100"/>
            <Button x:Name="ResetButton"
                    Content="VERIFY &amp; RESET"
                    Click="Reset_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#424242"
                    Width="150"/>
        </StackPanel>
    </Grid>
</Window>