<Window x:Class="GamePinned.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="GamePinned"
        Icon="pack://application:,,,/icon.ico"
        Height="720" Width="1100"
        MinHeight="620" MinWidth="1000"
        Background="#0F0F0F"
        TextElement.Foreground="White"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="Segoe UI Variable, Segoe UI, Sans-Serif"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0,0,0,0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                Margin="10,2"
                                CornerRadius="8"
                                Cursor="Hand">
                            <Grid>
                                <!-- Active background overlay — opacity animated on check/uncheck -->
                                <Rectangle x:Name="activeBg"
                                           Fill="#280008" RadiusX="8" RadiusY="8"
                                           Opacity="0" IsHitTestVisible="False"/>
                                <!-- Left red accent stripe -->
                                <Rectangle x:Name="activeAccent"
                                           Fill="#e60012" Width="3"
                                           HorizontalAlignment="Left"
                                           Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="15,11,12,11"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="activeBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="activeAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="activeBg"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="activeAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#181818"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="GroupName" Value="NavGroup"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#131313"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#242424"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Bar Button Styles -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#222222"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#B01E10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost x:Name="GlobalLoadingDialog" IsOpen="False" CloseOnClickAway="False">
        <materialDesign:DialogHost.DialogContent>
            <StackPanel Margin="30" HorizontalAlignment="Center">
                <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
                             Value="0" IsIndeterminate="True"
                             Width="40" Height="40" Margin="0,0,0,15" Foreground="#e60012"/>
                <TextBlock x:Name="GlobalLoadingText" Text="Loading..." FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </materialDesign:DialogHost.DialogContent>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#080808" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Window control buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click">
                            <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click">
                            <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="14" Height="14"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <!-- App title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Image Source="pack://application:,,,/icon.ico"
                               Height="16" Width="16"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="GamePinned" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#888" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        <!-- SIDEBAR -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0A0A0A" BorderBrush="#252525" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo/Brand (Fixed at top) -->
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,15">
                    <Image x:Name="SidebarLogo"
                           Source="pack://application:,,,/logo.png"
                           Width="96" Height="96"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    
                    <!-- Tier pill badge -->
                    <Border x:Name="TierBadge"
                            HorizontalAlignment="Center"
                            Margin="16,8,16,12"
                            CornerRadius="20"
                            Padding="13,5"
                            BorderThickness="1"
                            BorderBrush="#3A3A3A"
                            Background="#1E1E1E">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse x:Name="TierDot" Width="6" Height="6"
                                     Fill="#666" VerticalAlignment="Center" Margin="0,1,7,0"/>
                            <TextBlock x:Name="LicenseTierText" Text="FREE"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#999" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <Border DockPanel.Dock="Top" Height="1" Background="#2A2A2A" Margin="12,0,12,10"/>


                <!-- Nav Items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="True" PanningMode="VerticalOnly">
                <StackPanel Margin="0,5,0,0">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource SidebarButton}"
                                 IsChecked="True" Checked="Nav_Checked" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="PLATFORMS" FontSize="11" Foreground="#555555"
                               Margin="16,15,0,5" FontWeight="SemiBold"/>

                    <RadioButton x:Name="NavSteam" Style="{StaticResource SidebarButton}"
                                 Checked="Nav_Checked" Tag="Steam">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/steam_icon.png"
                                   Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Steam" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavEpic" Style="{StaticResource SidebarButton}"
                                 Checked="Nav_Checked" Tag="Epic">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/epic_icon.png"
                                   Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Epic Games" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavRiot" Style="{StaticResource SidebarButton}"
                                 Checked="Nav_Checked" Tag="Riot">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/riot_icon.png"
                                   Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Riot Games" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavNvidia" Style="{StaticResource SidebarButton}"
                                 Checked="Nav_Checked" Tag="Nvidia">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/nvidia_icon.png"
                                   Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="NVIDIA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="MANAGEMENT" FontSize="11" Foreground="#555555"
                               Margin="16,15,0,5" FontWeight="SemiBold"/>

                    <RadioButton x:Name="NavUsers" Style="{StaticResource SidebarButton}"
                                 Checked="Nav_Checked" Tag="Users">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Users" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavLicense" Style="{StaticResource SidebarButton}"
                                 Checked="Nav_Checked" Tag="License">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Key" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="License" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavLogs" Style="{StaticResource SidebarButton}"
                                 Checked="Nav_Checked" Tag="Logs">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TextBoxOutline" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarButton}"
                                 Checked="Nav_Checked" Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="20" Height="20"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <DockPanel Grid.Row="1" Grid.Column="1">

            <!-- Auth status banner -->
            <Border x:Name="AuthStatusBanner" DockPanel.Dock="Top" Height="30"
                    Background="#1E0000" BorderThickness="0,0,0,1" BorderBrush="#3D0000"
                    Cursor="Hand" MouseLeftButtonUp="AuthBanner_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon x:Name="AuthBannerIcon" Kind="LockOutline"
                                             Width="12" Height="12" Foreground="#FF5252"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="AuthBannerText" Text="LOCKED (click to unlock)"
                               FontSize="11" FontWeight="SemiBold" Foreground="#FF5252"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid>
            <!-- ========== DASHBOARD PAGE ========== -->
            <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" Focusable="True" PanningMode="VerticalOnly">
                <StackPanel Margin="25,20,25,25">

                    <!-- HERO: System Health Panel -->
                    <Border x:Name="HeroBorder" Background="#131313" CornerRadius="16" Padding="26,20" Margin="0,0,0,14"
                            BorderThickness="1" BorderBrush="#242424">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Row 1: Service status + buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ServiceStatusIndicator" Width="14" Height="14"
                                             Fill="Gray" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock x:Name="ServiceStatusText" Text="Checking..."
                                                   FontSize="22" FontWeight="Black" Foreground="White"/>
                                        <TextBlock Text="Protection Service" FontSize="11" Foreground="#555" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StartServiceButton" Content="START"
                                            Click="StartService_Click"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#1A3D1A" Foreground="#4CAF50"
                                            BorderThickness="0" Margin="0,0,8,0" Padding="16,6"
                                            FontSize="12" FontWeight="SemiBold"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Start the protection service"/>
                                    <Button x:Name="RestartServiceButton" Content="RESTART"
                                            Click="RestartService_Click"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#1A2028" Foreground="#607D8B"
                                            BorderThickness="0" Margin="0,0,8,0" Padding="16,6"
                                            FontSize="12" FontWeight="SemiBold"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Restart the protection service"/>
                                    <Button x:Name="StopServiceButton" Content="STOP"
                                            Click="StopService_Click"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#1E1E1E" Foreground="#757575"
                                            BorderThickness="0" Padding="16,6"
                                            FontSize="12" FontWeight="SemiBold"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Stop the protection service"/>
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="#242424" Margin="0,16,0,16"/>

                            <!-- Service stopped note (only visible when service is not running) -->
                            <Border x:Name="ServiceStoppedNote"
                                    Background="#1C1400" BorderBrush="#4A3800" BorderThickness="1"
                                    CornerRadius="8" Padding="12,9" Margin="0,0,0,14"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Foreground="#FFB300" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#CCAA44">
                                        <Run FontWeight="SemiBold">Service stopped.</Run>
                                        <Run>Protection is still active. To allow uninstalls, start the service and enable Maintenance Mode.</Run>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Row 2: Maintenance Mode -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Maintenance Mode" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        <Button Tag="https://gamepinned.com/docs/maintenance"
                                                Click="OpenUrl_Click"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="#555" Padding="4,0" Height="20" Width="Auto"
                                                VerticalAlignment="Center" Margin="5,0,0,0"
                                                ToolTip="Open Maintenance Mode docs">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="13" Height="13"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="MaintenanceModeText"
                                               Text="Locks active. Toggle to allow uninstalls."
                                               FontSize="11" Foreground="#555" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="MaintenanceModeToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="#C41010"
                                              materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="#252525"
                                              Checked="MaintenanceMode_Toggled"
                                              Unchecked="MaintenanceMode_Toggled"
                                              VerticalAlignment="Center"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTip="Removes protection from every game across every platform at once. Speed depends on your storage drive."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- STATS: 2x2 grid -->
                    <Grid x:Name="DashStatsGrid" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Games Locked -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#131313" CornerRadius="14" Padding="22,18"
                                BorderThickness="1" BorderBrush="#242424">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="StatProtectedCount" Text="0"
                                               FontSize="34" FontWeight="Black" Foreground="#4CAF50"/>
                                    <TextBlock Text="GAMES LOCKED" FontSize="10" Foreground="#444444"
                                               FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="ShieldCheck"
                                                         Width="26" Height="26" Foreground="#2A2A2A"
                                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Total Games -->
                        <Border Grid.Row="0" Grid.Column="2" Background="#131313" CornerRadius="14" Padding="22,18"
                                BorderThickness="1" BorderBrush="#242424">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="StatTotalGamesCount" Text="0"
                                               FontSize="34" FontWeight="Black" Foreground="#2196F3"/>
                                    <TextBlock Text="TOTAL GAMES" FontSize="10" Foreground="#444444"
                                               FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="Gamepad"
                                                         Width="26" Height="26" Foreground="#2A2A2A"
                                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Banned Users -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#131313" CornerRadius="14" Padding="22,18"
                                BorderThickness="1" BorderBrush="#242424">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="StatUsersCount" Text="0"
                                               FontSize="34" FontWeight="Black" Foreground="#e60012"/>
                                    <TextBlock Text="BLOCKED USERS" FontSize="10" Foreground="#444444"
                                               FontWeight="Bold" Margin="0,5,0,0"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="AccountRemove"
                                                         Width="26" Height="26" Foreground="#2A2A2A"
                                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Platforms Active -->
                        <Border Grid.Row="2" Grid.Column="2" Background="#131313" CornerRadius="14" Padding="22,18"
                                BorderThickness="1" BorderBrush="#242424">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="StatPlatformsCount" Text="0"
