                                        Background="#1A1A2E" Foreground="#8888CC"
                                        Padding="14,6"
                                        ToolTip="Sign out all Riot accounts on this PC">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountRemove" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="CLEAR SESSION" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Tag="https://gamepinned.com/docs/session-clear"
                                        Click="OpenUrl_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#555" Width="28" Height="28" Padding="4"
                                        Margin="4,0,0,0" VerticalAlignment="Center"
                                        ToolTip="How Session Clear works">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== USERS PAGE ========== -->
            <ScrollViewer x:Name="PageUsers" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed" Focusable="True" PanningMode="VerticalOnly">
                <StackPanel Margin="25">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right"
                                        Tag="https://gamepinned.com/docs/how-it-works#scope"
                                        Click="OpenUrl_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#555" Padding="6,2" Height="Auto" Width="Auto"
                                        VerticalAlignment="Center"
                                        ToolTip="How blocked users work">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookOpenVariant" Width="12" Height="12"
                                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="docs" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="These users can't uninstall locked games."
                                           Foreground="#888" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- Chip-style user list -->
                            <ItemsControl x:Name="BlockedUsersListBox" MinHeight="52">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A0000" CornerRadius="20" Padding="10,5"
                                                Margin="0,0,6,6" BorderBrush="#3A0000" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Account" Foreground="#888"
                                                                         Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding}" Foreground="#DDD" FontSize="12" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Foreground="#555" Width="22" Height="22"
                                                        Margin="6,0,0,0" Padding="0"
                                                        Tag="{Binding}"
                                                        Click="RemoveUserChip_Click"
                                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                                        ToolTip="Remove this user from the blocked list">
                                                    <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Empty hint -->
                            <TextBlock x:Name="NoUsersHint" Text="No accounts added. All standard Windows accounts are blocked by default."
                                       Foreground="#555555" FontSize="11" FontStyle="Italic"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Add User" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" Margin="0,0,0,10"/>

                            <!-- User Format Help -->
                            <TextBlock Text="Username formats:" Foreground="#AAA" FontSize="12" Margin="0,15,0,5"/>
                            <TextBlock Text="• COMPUTERNAME\username (for local/domain accounts)" Foreground="#AAA" FontSize="11" Margin="15,0,0,2"/>
                            <TextBlock Text="• username@domain (for Microsoft or domain accounts)" Foreground="#AAA" FontSize="11" Margin="15,0,0,2"/>

                            <!-- Default Behavior -->
                            <TextBlock Text="Leave empty to block all standard Windows accounts, or add specific accounts below."
                                       Foreground="#FFB3B3" FontSize="12" Margin="0,10,0,15" FontWeight="SemiBold" TextWrapping="Wrap"/>

                            <Grid Margin="0,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AddUserTextBox"
                                         materialDesign:HintAssist.Hint="Account Name"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Click="AddUser_Click"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#333" Foreground="White"
                                        Padding="14,6"
                                        ToolTip="Block this account from uninstalling locked games">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountPlus" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="ADD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== LICENSE PAGE ========== -->
            <ScrollViewer x:Name="PageLicense" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed" Focusable="True" PanningMode="VerticalOnly">
                <StackPanel Margin="25">
                    <!-- Hardware ID -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        Tag="https://gamepinned.com/docs/how-it-works#license"
                                        Click="OpenUrl_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#555" Padding="8,4" Height="Auto" Width="Auto"
                                        VerticalAlignment="Center"
                                        ToolTip="How hardware binding works">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BookOpenVariant" Width="12" Height="12"
                                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="docs" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Memory" Foreground="#888"
                                                             Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Hardware ID" FontSize="17" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Tied to this PC's hardware. Required for license activation."
                                       Foreground="#AAA" FontSize="14" Margin="0,0,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HardwareIdTextBox"
                                         IsReadOnly="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontFamily="Consolas" FontSize="13"
                                         VerticalAlignment="Center"
                                         BorderBrush="#444"
                                         Foreground="#DDD"
                                         materialDesign:HintAssist.Hint="Hardware ID"/>
                                <Button Grid.Column="1"
                                        ToolTip="Copy to Clipboard"
                                        Click="CopyHardwareId_Click"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Foreground="#888"
                                        Margin="10,0,0,0" Height="40" Width="40">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="20" Height="20"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- License Status -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Seal" Foreground="#888"
                                                         Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="License Status" FontSize="17" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Margin="0,0,15,10" Foreground="#888" FontSize="14"/>
                                <TextBlock x:Name="LicenseStatusText" Grid.Row="0" Grid.Column="1" Text="Checking..." FontWeight="Bold" Foreground="#4CAF50" FontSize="14"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" FontWeight="SemiBold" Margin="0,0,15,10" Foreground="#888" FontSize="14"/>
                                <TextBlock x:Name="LicenseTypeText" Grid.Row="1" Grid.Column="1" Text="--" Foreground="White" FontSize="14"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Expiry:" FontWeight="SemiBold" Margin="0,0,15,0" Foreground="#888" FontSize="14"/>
                                <TextBlock x:Name="LicenseExpiryText" Grid.Row="2" Grid.Column="1" Text="--" Foreground="White" FontSize="14"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Activate License -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Key" Foreground="#888"
                                                         Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Activate License" FontSize="17" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Enter your license key to activate GamePinned."
                                       Foreground="#AAA" FontSize="14" Margin="0,0,0,15" TextWrapping="Wrap"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LicenseKeyTextBox"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="License Key"
                                         FontFamily="Consolas"
                                         Foreground="White"
                                         VerticalAlignment="Center"
                                         BorderBrush="#444"/>
                                <Button x:Name="ActivateLicenseButton"
                                        Grid.Column="1"
                                        Content="ACTIVATE"
                                        Click="ActivateLicense_Click"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#e60012" Foreground="White"
                                        Margin="15,0,0,0"
                                        Height="40"
                                        Padding="16,0"
                                        ToolTip="Activate your license key"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== LOGS PAGE ========== -->
            <Grid x:Name="PageLogs" Visibility="Collapsed" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Content="REFRESH"
                                Click="RefreshLogs_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#333" Foreground="White"
                                Margin="0,0,8,0" Padding="14,6"
                                ToolTip="Reload the latest log entries"/>
                        <Button Content="CLEAR"
                                Click="ClearLogs_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#333" Foreground="White"
                                Padding="14,6"
                                ToolTip="Clear all log entries"/>
                    </StackPanel>
                    <TextBlock Text="Logs are kept for 7 days."
                               FontSize="11" Foreground="#666"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0" Padding="0">
                    <RichTextBox x:Name="LogsTextBox"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="#161616"
                                 Foreground="#CCC"
                                 BorderThickness="0"
                                 Padding="12"
                                 IsDocumentEnabled="True">
                        <RichTextBox.Document>
                            <FlowDocument PagePadding="0" LineHeight="18"/>
                        </RichTextBox.Document>
                    </RichTextBox>
                </Border>
            </Grid>

            <!-- ========== SETTINGS PAGE ========== -->
            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed" Focusable="True" PanningMode="VerticalOnly">
                <StackPanel Margin="30,25">

                    <!-- System card (Security + Updates merged) -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0">
                        <StackPanel>

                            <!-- Row: Launch with Windows -->
                            <DockPanel>
                                <ToggleButton x:Name="StartWithWindowsCheckBox"
                                              DockPanel.Dock="Right"
                                              Click="StartWithWindows_Click"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="#4CAF50"
                                              materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="#252525"
                                              VerticalAlignment="Center"
                                              ToolTip="Enable/Disable Startup"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Power" Foreground="#888"
                                                             Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Launch with Windows" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                            <Border x:Name="StartupPaidBadge" Background="#031E2E" BorderBrush="#0D5E8A"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="PRO" Foreground="#4FC3F7" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Start GamePinned when Windows boots."
                                                   FontSize="12" Foreground="#666" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <Separator Margin="0,18" Background="#252525"/>

                            <!-- Row: Admin Password -->
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Shield" Foreground="#888"
                                                         Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Admin Password" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        <Button Tag="https://gamepinned.com/docs/security"
                                                Click="OpenUrl_Click"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="#555" Padding="4,0" Height="20" Width="Auto"
                                                VerticalAlignment="Center" Margin="5,0,0,0"
                                                ToolTip="Open security docs">
                                            <materialDesign:PackIcon Kind="HelpCircleOutline" Width="13" Height="13"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Prevents users from changing settings or closing the app."
                                               FontSize="12" Foreground="#666" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid Margin="32,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="AdminPasswordBox"
                                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                             materialDesign:HintAssist.Hint="New password"
                                             BorderBrush="#333"
                                             Foreground="White"
                                             VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="SET PASSWORD"
                                        Click="SetAdminPassword_Click"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#2A2A2A" Foreground="White"
                                        BorderBrush="#444" BorderThickness="1"
                                        Margin="10,0,0,0"
                                        Height="40"
                                        Padding="16,0"
                                        ToolTip="Require a password to change settings"/>
                            </Grid>
                            <TextBlock x:Name="PasswordStatusText"
                                       Text="" FontSize="12" Foreground="#888" Margin="32,6,0,0"/>

                            <Separator Margin="0,18" Background="#252525"/>

                            <!-- Row: Automatic Updates -->
                            <DockPanel>
                                <ToggleButton x:Name="AutoUpdateToggle"
                                              DockPanel.Dock="Right"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="#4CAF50"
                                              materialDesign:ToggleButtonAssist.SwitchTrackOffBackground="#252525"
                                              Click="AutoUpdateToggle_Click"
                                              VerticalAlignment="Center"
                                              ToolTip="Download and install updates silently"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Sync" Foreground="#888"
                                                             Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Automatic Updates" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                            <Button Tag="https://gamepinned.com/docs/updating"
                                                    Click="OpenUrl_Click"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="#555" Padding="4,0" Height="20" Width="Auto"
                                                    VerticalAlignment="Center" Margin="5,0,0,0"
                                                    ToolTip="Open updating docs">
                                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="13" Height="13"/>
                                            </Button>
                                            <Border x:Name="AutoUpdatePaidBadge" Background="#031E2E" BorderBrush="#0D5E8A"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="PRO" Foreground="#4FC3F7" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Downloads and installs updates silently."
                                                   FontSize="12" Foreground="#666" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <Separator Margin="0,18" Background="#252525"/>

                            <!-- Row: Check for Updates -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="CHECK NOW"
                                        Click="CheckUpdates_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="White"
                                        BorderBrush="#444"
                                        Padding="16,6"
                                        ToolTip="Check for a newer version now"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CloudDownload" Foreground="#888"
                                                             Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Check for Updates" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Manually check for a newer version."
                                                   FontSize="12" Foreground="#666" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <Separator Margin="0,18" Background="#252525"/>

                            <!-- Row: Installed Version -->
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="#1A1A1A" BorderBrush="#333"
                                        BorderThickness="1" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                                    <TextBlock x:Name="CurrentVersionText" FontSize="12" Foreground="#888"
                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Tag" Foreground="#888"
                                                             Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Installed Version" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                        </StackPanel>
                    </Border>

                    <!-- Support & Feedback card -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>

                            <!-- Card header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <materialDesign:PackIcon Kind="Information" Foreground="#888"
                                                         Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Help" FontSize="15" FontWeight="SemiBold" Foreground="#AAA" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Support -->
                            <DockPanel Margin="0,4,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#888" Padding="10,4" Click="Website_Click">
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Foreground="#666" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Support &amp; Feedback" FontSize="13" Foreground="#CCC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Docs -->
                            <DockPanel Margin="0,4,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#888" Padding="10,4" Click="OpenDocs_Click">
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="BookOpenVariant" Foreground="#666" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Docs" FontSize="13" Foreground="#CCC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Changelog -->
                            <DockPanel Margin="0,4,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#888" Padding="10,4" Click="OpenChangelog_Click">
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ClipboardText" Foreground="#666" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Changelog" FontSize="13" Foreground="#CCC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- FAQ -->
                            <DockPanel Margin="0,4,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#888" Padding="10,4" Click="OpenFaq_Click">
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Foreground="#666" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="FAQ" FontSize="13" Foreground="#CCC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <Separator Margin="0,14" Background="#252525"/>

                            <!-- Row: Diagnostic report -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="#888" Padding="12,6"
                                        Click="SendDiagnosticReport_Click"
                                        ToolTip="Sends today's debug log to GamePinned support">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Upload" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="SEND" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BugReport" Foreground="#888" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Diagnostic Report" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                    <TextBlock Text="Send today's log to support."
                                               FontSize="12" Foreground="#666" Margin="28,3,0,0"/>
                                </StackPanel>
                            </DockPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== NVIDIA PAGE ===== -->
            <ScrollViewer x:Name="PageNvidia" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed" Focusable="True" PanningMode="VerticalOnly">
                <StackPanel Margin="32" MaxWidth="640" HorizontalAlignment="Left">

                    <DockPanel Margin="0,0,0,24">
                        <Button DockPanel.Dock="Right"
                                Tag="https://gamepinned.com/docs/gpu-pinned"
                                Click="OpenUrl_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#555" Padding="8,4" Height="Auto" Width="Auto"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                ToolTip="Open GPU Pinned docs">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookOpenVariant" Width="12" Height="12"
                                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="docs" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="GPU Pinned saves your NVIDIA settings as a profile and restores them on every reboot."
                                   FontSize="13" Foreground="#666" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- PAID badge banner -->
                    <Border x:Name="NvidiaPaidBanner" Background="#1276B900" BorderBrush="#3376B900"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Lock" Foreground="#76B900" Width="16" Height="16"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Foreground="#76B900" FontSize="13" VerticalAlignment="Center">
                                <Run FontWeight="SemiBold">PRO / ELITE Feature</Run>
                                <Run Foreground="#4A7A20"> Upgrade to PRO or ELITE to unlock.</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- GPU Hardware card (left green accent stripe) -->
                    <Border x:Name="NvidiaGpuInfoCard" CornerRadius="8" Background="#111111"
                            BorderBrush="#222222" BorderThickness="1" Margin="0,0,0,12" ClipToBounds="True">
                        <Grid Height="64">
                            <Border Width="4" HorizontalAlignment="Left" Background="#76B900"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,20,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/nvidia_icon.png"
                                       Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,14,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="NvidiaGpuNameText" Text="Detecting GPU..."
                                               FontSize="14" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Background="#1C1C1C" CornerRadius="3" Padding="7,2" Margin="0,0,7,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Driver " FontSize="11" Foreground="#444"/>
                                                <TextBlock x:Name="NvidiaDriverText" Text="—" FontSize="11" Foreground="#777"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1C1C1C" CornerRadius="3" Padding="7,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="VRAM " FontSize="11" Foreground="#444"/>
                                                <TextBlock x:Name="NvidiaVramText" Text="—" FontSize="11" Foreground="#777"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- No NVIDIA warning banner -->
                    <Border x:Name="NvidiaNotDetectedCard" Background="#180E0E" BorderBrush="#3DE57373"
                            BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="#C0554444" Width="17" Height="17"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="No NVIDIA GPU detected. GPU Pinned requires an NVIDIA graphics card."
                                       FontSize="12" Foreground="#885555" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Saved Profiles card -->
                    <Border CornerRadius="8" Background="#111111" BorderBrush="#222222" BorderThickness="1">
                        <StackPanel>

                            <!-- Header: title + SAVE NEW PROFILE button -->
                            <Grid Margin="20,16,20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Saved Profiles" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center"/>
                                <Button x:Name="SaveNvidiaConfigButton" Grid.Column="1"
                                        Content="SAVE NEW PROFILE"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="SaveNvidiaConfig_Click"
                                        Background="#76B900" Foreground="Black"
                                        FontSize="11" FontWeight="Bold" Padding="14,6"
                                        ToolTip="Save current NVIDIA settings as a GPU Pinned profile"/>
                            </Grid>

                            <!-- Profiles list — populated in code-behind -->
                            <StackPanel x:Name="NvidiaProfilesList" Margin="12,0,12,0"/>

                            <!-- Empty-state hint — shown when no profiles saved -->
                            <Border x:Name="NvidiaNoProfilesHint" Margin="12,0,12,16"
                                    Background="#0C0C0C" BorderBrush="#1A1A1A" BorderThickness="1"
                                    CornerRadius="5" Padding="14,11">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="#2A2A2A"
                                                             Width="16" Height="16" VerticalAlignment="Center"
                                                             Margin="0,0,10,0"/>
                                    <TextBlock Text="No profiles saved yet. Click SAVE NEW PROFILE to get started."
                                               FontSize="12" Foreground="#2A2A2A" TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Divider -->
                            <Rectangle Height="1" Fill="#1A1A1A"/>

                            <!-- Auto-restore toggle row -->
                            <DockPanel Margin="20,13,20,13">
                                <ToggleButton x:Name="NvidiaAutoRestoreToggle" DockPanel.Dock="Right"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              Click="NvidiaAutoRestore_Click" VerticalAlignment="Center"
                                              ToolTip="Restore the active profile on every boot"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Auto-restore on startup" FontSize="13"
                                               FontWeight="SemiBold" Foreground="#B0B0B0"/>
                                    <TextBlock Text="Restores on every reboot."
                                               FontSize="11" Foreground="#3A3A3A"/>
                                </StackPanel>
                            </DockPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            </Grid>
        </DockPanel>
    </Grid>
    </materialDesign:DialogHost>
</Window>
