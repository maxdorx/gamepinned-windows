<Application x:Class="GamePinned.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design -->
                <materialDesign:BundledTheme BaseTheme="Dark"
                                            PrimaryColor="Grey"
                                            SecondaryColor="DeepPurple" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Override Material Design colors for matte black -->
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#333333" />
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#222222" />
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#0F0F0F" />
            <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#FF4B4B" />
            <SolidColorBrush x:Key="MaterialDesignPaper" Color="#0F0F0F" />
            <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#1A1A1A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
