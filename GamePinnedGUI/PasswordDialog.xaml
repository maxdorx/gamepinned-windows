<Window x:Class="GamePinned.GUI.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Admin Authentication"
        SizeToContent="Height" MinHeight="220" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText"
                   Grid.Row="0"
                   Text="Enter admin password:"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

        <PasswordBox x:Name="PasswordInput"
                     Grid.Row="1"
                     FontSize="14"
                     Padding="8"
                     Foreground="White"
                     materialDesign:HintAssist.Hint="Password"
                     KeyDown="PasswordInput_KeyDown"/>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,8,0,0"/>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Button x:Name="ForgotPasswordButton"
                    Content="Forgot password?"
                    Click="ForgotPassword_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#666"
                    FontSize="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="0"
                    Cursor="Hand"
                    Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL"
                        Click="Cancel_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#333333"
                        Margin="0,0,10,0"
                        Width="100"/>
                <Button x:Name="OkButton"
                        Content="OK"
                        Click="OK_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#424242"
                        Width="100"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
