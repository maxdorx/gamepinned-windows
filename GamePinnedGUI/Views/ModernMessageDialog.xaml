<Window x:Class="GamePinned.GUI.Views.ModernMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Message" Height="250" Width="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,15,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <materialDesign:PackIcon x:Name="IconIcon" Kind="Information" Width="24" Height="24" 
                                         VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="Title" 
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBody}"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" Margin="20,0,20,10" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" Text="Message content goes here..." 
                           TextWrapping="Wrap" FontSize="14" Foreground="#CCC"/>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
                <Button x:Name="YesButton" Content="YES" Style="{StaticResource MaterialDesignFlatButton}" 
                        Click="YesButton_Click" Visibility="Collapsed" Margin="0,0,10,0" Foreground="#4CAF50"/>
                
                <Button x:Name="NoButton" Content="NO" Style="{StaticResource MaterialDesignFlatButton}" 
                        Click="NoButton_Click" Visibility="Collapsed" Margin="0,0,10,0" Foreground="#E53935"/>
                
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource MaterialDesignRaisedButton}" 
                        Click="OkButton_Click" Width="80"/>
                
                <Button x:Name="CancelButton" Content="CANCEL" Style="{StaticResource MaterialDesignFlatButton}" 
                        Click="CancelButton_Click" Visibility="Collapsed" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
